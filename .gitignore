# Compiled and build artifacts
__pycache__/
*.pyc
*.py[cod]
*.egg-info/
*.egg
*.o
*.obj
dist/
build/
# Unanchored on purpose. `rust/target/` contains a slash, so git anchors it to
# the repository root and it matches nothing deeper. Every cargo invocation in
# the gate runs after a `cd` into `rust/` (merge-gate.sh:66, run-all-tests.sh:184,
# crap-gate.sh:6, mutants-gate.sh:5), and CARGO_TARGET_DIR is resolved against
# each process's own directory — so exporting a *relative* one lands the build
# in `rust/rust/target-sil/`, which the anchored patterns did not cover. That
# tree reached 11 GB untracked before anyone noticed it existed.
target/
# Scratch target dirs the gate scripts create so a run does not clobber the
# locked live exe, plus cargo-mutants scratch. Never committed.
target-*/
mutants.out/
mutants.out.old/

# Dependencies
.venv/
venv/
node_modules/
npm/.bin/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*
# `.env.*` only matches names that START with `.env.`, so the env file the
# installer writes — `memory-industry.env`, which carries the bearer token for
# the whole graph and the database URL — was not covered by any pattern here.
# `*.env` is: no tracked file ends in `.env`, and the one this repo publishes as
# an example ends in `.example`.
*.env
!.env.example

# Editors
.vscode/
.idea/

# Regenerated by scripts/record-demo-gif.sh (GIF is committed)
assets/demo.cast

# Project-specific (cuba-memorys)
.mypy_cache/
.pytest_cache/
.hypothesis/
.ruff_cache/
uv.lock
.fastembed_cache/
.claude/
.grok/
.mcp.json
.mcpregistry_*
.DS_Store
Thumbs.db

# Database backups (local only — never commit dumps)
backups/
!backups/.gitkeep

# Internal working files — kept local, never published.
# `docs/*` (not `docs/`) so `!docs/gate.md` can re-include the merge-judge doc.
# git will not un-ignore a file whose parent directory is ignored.
docs/*
!docs/gate.md
!docs/despliegue-lan.md
sandbox/
*.jsonl.partial

# Six-pack / gate rules are of the repo (Mapupita-Rust lesson: a junction
# to ~/.cursor/rules wipes project rules on clone). Handoffs are per-turn.
.cursor/handoffs/*
!.cursor/handoffs/handoff.example.yml


# local production secrets
.deploy/

