# MemoryIndustry — loopback profile
#
# Generated by `memory-industry setup service`. The generator is the same
# binary that reads these back, so the copy under packaging/ is not edited by
# hand: rust/tests/packaging_contract.rs compares it against the renderer.
#
# Placement is decided by the resource planner at startup; doctor --deep prints what it chose.

# --- Only you know these -----------------------------------------------------
CUBA_HTTP_TOKEN=
CUBA_HTTP_ADDR=127.0.0.1:8787
CUBA_MODE=completo
DATABASE_URL=
ONNX_MODEL_PATH=
ORT_DYLIB_PATH=

# --- The resource planner measures these -------------------------------------
# Offered, never set. A value written here beats the measurement for good,
# because resources::set_if_absent leaves an already-set variable alone — that
# is how a hand-pinned GPU ceiling beat every card this daemon ever ran on.
# To use less VRAM, say so where it is true: CUBA_RERANK_DEVICE=cpu.
# CUBA_EMBED_INTRA_THREADS=
# CUBA_RERANK_INTRA_THREADS=
# CUBA_NLI_INTRA_THREADS=
# CUBA_RERANK_CHUNK=
# CUBA_DB_MAX_CONNECTIONS=
# CUBA_OOD_FIT_LIMIT=
# CUBA_RERANK_DEVICE=
# CUBA_GPU_MEM_LIMIT_MB=
# CUBA_RERANKER_PATH=
# CUBA_NLI_PATH=
