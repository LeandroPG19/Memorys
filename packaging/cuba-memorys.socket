# Socket activation: this unit owns the port, so the daemon does not have to be
# running to keep it. The first connection starts cuba-memorys.service, and with
# CUBA_IDLE_SHUTDOWN_SECS set the daemon exits again once nobody is asking —
# which is what takes its idle footprint to zero rather than a few gigabytes of
# RAM and VRAM held from boot.
#
#   systemctl --user daemon-reload
#   systemctl --user disable --now cuba-memorys.service   # drop always-on mode
#   systemctl --user enable  --now cuba-memorys.socket
#
# `serve` adopts the socket systemd passes as fd 3 (LISTEN_FDS), so no client
# ever sees a refused connection while the daemon is down. Unix only — on
# Windows there is no systemd and `serve` binds the address itself.
[Unit]
Description=cuba-memorys daemon socket — brings the daemon up on the first MCP call
Documentation=https://github.com/LeandroPG19/Memorys

[Socket]
ListenStream=127.0.0.1:8787
Accept=no

[Install]
WantedBy=default.target
