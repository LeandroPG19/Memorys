# PostgreSQL (optional — auto-provision via Docker if unset)
# DATABASE_URL=postgresql://cuba:memorys2026@localhost:5488/brain

# Core
# RUST_LOG=memory_industry=info

# Optional ONNX / runtime
# ONNX_MODEL_PATH=
# ORT_DYLIB_PATH=
# CUBA_RERANKER_PATH=

# v0.8+ features
# CUBA_PROJECT_FILTER=off
# CUBA_SYNC_DIR=./.memory-industry
# CUBA_JUDGE=auto
# CUBA_JUEZ_CLI=claude
# CUBA_JUEZ_MODEL=claude-haiku-4-5
# CUBA_JUEZ_TIMEOUT_SECS=30
# CUBA_JUEZ_MAX_PAIRS=5

# MemoryIndustry generative LLM (preferred names; CUBA_* still work)
# MEMORY_INDUSTRY_JUDGE=auto
# MEMORY_INDUSTRY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MEMORY_INDUSTRY_LLM_MODEL=llama3.2
# MEMORY_INDUSTRY_LLM_CLI=claude
# MEMORY_INDUSTRY_LLM_PROVIDER=deepseek
#   # presets: deepseek qwen moonshot zhipu siliconflow yi doubao baichuan minimax
#   #          openai openrouter together groq mistral fireworks ollama lmstudio vllm gemini_openai
# MEMORY_INDUSTRY_LLM_API_KEY=
#   # or vendor keys: DEEPSEEK_API_KEY DASHSCOPE_API_KEY MOONSHOT_API_KEY ZHIPU_API_KEY OPENAI_API_KEY …

# v0.10 bitemporal (default on; set 0 to disable brain_facts mirror on write)
# CUBA_BITEMPORAL=0

# Backups (scripts/backup-db.sh — keeps last 7 dumps in ./backups/)
# DATABASE_URL=postgresql://cuba:memorys2026@localhost:5488/brain
# BACKUP_DIR=./backups
# KEEP_COUNT=7
# =============================================================================
# Deployment surface
#
# Everything below is what you set to stand a daemon up. It is kept in step
# with the code by rust/tests/doc_contract.rs: a variable read in http.rs,
# gpu.rs, mode.rs or resources.rs, or pinned by a unit in packaging/, has to
# appear here or the gate fails. The README stays the reference; this file is
# the thing you copy.
# =============================================================================

# --- HTTP daemon (`memory-industry serve`) -----------------------------------
# CUBA_HTTP_ADDR=127.0.0.1:8787
# CUBA_HTTP_TOKEN=
#   # Bearer token. MANDATORY to bind anything but loopback — serve refuses to
#   # start otherwise, because /mcp reaches the entire graph. Generate a long
#   # random one; it travels in clear text over the LAN.
# CUBA_PEER_TOKEN=
#   # Read-only second token for another node that syncs with this one. Must
#   # differ from CUBA_HTTP_TOKEN or serve refuses to start.
# CUBA_IDLE_SHUTDOWN_SECS=0
#   # Exit after this long with no request. Pairs with a .socket unit.
# CUBA_HANDLER_TIMEOUT_SECS=30
#   # Ceiling on one tool call. The HTTP daemon derives two more from it:
#   # a per-request deadline at 4x that answers with a JSON-RPC envelope
#   # naming the call that died, and a router deadline at 8x that closes the
#   # connection with a 504 when even that did not come back. Raise it for a
#   # slow local model; 0 is ignored and falls back to 30.
# CUBA_HTTP_ALLOWED_ORIGINS=
#   # Extra browser origins for /mcp and /panel, comma separated. Requests
#   # with no Origin always pass (every MCP client). localhost and 127.0.0.1
#   # on this port are allowed already.
# CUBA_PANEL=
#   # 1 also answers GET /panel. Off by default.
# CUBA_PANEL_PUBLIC=
#   # Without it /panel refuses requests carrying a forwarding header. It does
#   # NOT catch a raw TCP forward, and a LAN bind is not a proxy either.

# --- Per-model placement -----------------------------------------------------
# Only the reranker gains from a GPU. The embedder is INT8 and the CUDA
# provider has no kernel for DynamicQuantizeLinear/MatMulInteger, so it runs on
# CPU whatever you set; the NLI model is FP32 and not worth the VRAM.
# CUBA_EMBED_DEVICE=cpu
# MEMORY_INDUSTRY_RERANK_DEVICE=gpu
# CUBA_RERANK_DEVICE=gpu
#   # Either name works; MEMORY_INDUSTRY_ wins if both are set. Leave it unset
#   # and the resource plan decides from the card it measured.
# CUBA_NLI_DEVICE=cpu
# MEMORY_INDUSTRY_GPU_MEM_LIMIT_MB=
# CUBA_GPU_MEM_LIMIT_MB=
#   # Caps the CUDA arena; arena_extend_strategy is pinned to SameAsRequested.
#   # The cap is PER SESSION, not global.
#   # YOU DO NOT NEED TO SET THIS. The resource plan measures it: all the free
#   # VRAM on the card minus a 512 MiB reserve. It used to be pinned at 2048
#   # MiB on every machine, which no bge-reranker-v2-m3 fits in, and that is
#   # what made every GPU install die on BFCArena::AllocateRawInternal.
#   # A value below the floor the model demonstrably needs is RAISED, with an
#   # ERROR naming both numbers — a cap under the floor saves no VRAM, it only
#   # moves the failure into the middle of the load. To use less VRAM say so
#   # where it is true: RERANK_DEVICE=cpu.
#   # Verify with `memory-industry doctor --deep`.
# ORT_DYLIB_PATH=
#   # Full path to onnxruntime(.dll|.so). For GPU the CUDA provider libraries
#   # must sit next to it AND be reachable on PATH / LD_LIBRARY_PATH.

# --- Reranker ----------------------------------------------------------------
# CUBA_RERANK_CHUNK=16
#   # Candidates per forward pass. Under fixed shapes every batch pads to 512
#   # tokens, so this is the main lever on the arena: 16 -> 2938 MiB,
#   # 4 -> 2364 MiB. Scores are unchanged.
# CUBA_RERANK_INTRA_THREADS=
#   # Physical cores, or 2 on GPU. Past the physical core count it gets slower.
# MEMORY_INDUSTRY_WARM_RERANKER=
# CUBA_WARM_RERANKER=
#   # On by default. Set 0/off/false/no to defer the load into the first
#   # search that asks for reranking — which does not save the cost, it just
#   # moves it somewhere that cannot afford it.
#   # Either name works; MEMORY_INDUSTRY_ wins if both are set.
# MEMORY_INDUSTRY_WARM_BEFORE_SERVE_SECS=180
# CUBA_WARM_BEFORE_SERVE_SECS=180
#   # How long `serve` waits for the models after binding, before it announces
#   # itself. Past the budget it serves anyway and /health says ready:false.

# --- Embedder ----------------------------------------------------------------
# CUBA_EMBED_MODEL=bge-m3
# CUBA_EMBEDDING_DIM=1024
# CUBA_POOLING=cls
# CUBA_QUERY_PREFIX=
# CUBA_PASSAGE_PREFIX=
# CUBA_EMBED_INTRA_THREADS=
#   # Half the logical cores, max 4. Measured on 12 threads: 4 -> 35,8 ms/query,
#   # 6 -> 68,1 ms, 12 -> 155,4 ms. More is not faster.

# --- NLI ---------------------------------------------------------------------
# CUBA_NLI_PATH=
# CUBA_NLI_INTRA_THREADS=

# MEMORY_INDUSTRY_DOCTOR_DEEP_SECS=300
#   # How long `doctor --deep` waits for one model to open. Expiring is a
#   # reported failure, not a hang and not a skip.

# --- Mode, database and resource plan ----------------------------------------
# CUBA_MODE=completo
# CUBA_DB_MAX_CONNECTIONS=
# CUBA_OOD_FIT_LIMIT=
# CUBA_SKIP_MIGRATIONS=
#   # 1 when a unit already migrated the database at install time.
